<Window x:Class="TinyWinBuilder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TinyWin Builder - 离线 Windows 精简工具"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Height="50" Background="#1976D2">
            <TextBlock Text="TinyWin Builder" Foreground="White" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock Text="离线 Windows 镜像精简工具" Foreground="#BBDEFB" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
        </Grid>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <ListBox x:Name="NavList" Grid.Column="0" SelectionChanged="NavList_SelectionChanged"
                     Background="#FFFFFF" BorderThickness="0,0,1,0" BorderBrush="#E0E0E0">
                <ListBoxItem Content="图像" IsSelected="True" Padding="16,12"/>
                <ListBoxItem Content="预装应用" Padding="16,12"/>
                <ListBoxItem Content="系统功能" Padding="16,12"/>
                <ListBoxItem Content="注册表 Tweaks" Padding="16,12"/>
                <ListBoxItem Content="应用更改" Padding="16,12"/>
            </ListBox>

            <!-- 右侧内容 -->
            <ScrollViewer Grid.Column="1" Padding="20">
                <Grid>
                    <!-- 图像页 -->
                    <StackPanel x:Name="ImagePanel">
                        <TextBlock Text="离线镜像管理" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        
                        <TextBlock Text="1. 选择 WIM 镜像文件" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WimPathBox" IsReadOnly="True" Padding="6,4"/>
                            <Button Content="浏览..." Click="BrowseWim_Click" Grid.Column="1" Margin="8,0,0,0" Padding="16,4"/>
                        </Grid>

                        <TextBlock Text="2. 选择镜像版本" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <ComboBox x:Name="ImageIndexCombo" Margin="0,0,0,12" MinWidth="300"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="MountBtn" Content="挂载镜像" Click="Mount_Click" Padding="20,6" Background="#1976D2" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 应用页 -->
                    <StackPanel x:Name="AppsPanel" Visibility="Collapsed">
                        <TextBlock Text="预装应用管理" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBlock Text="勾选要移除的预装 UWP 应用（挂载镜像后可用）" Foreground="#888" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="全选" Click="SelectAllApps_Click" Padding="16,4" Margin="0,0,8,0"/>
                            <Button Content="反选" Click="InvertApps_Click" Padding="16,4" Margin="0,0,8,0"/>
                            <Button Content="清空" Click="ClearApps_Click" Padding="16,4"/>
                        </StackPanel>
                        <ItemsControl x:Name="AppsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,4" FontSize="13"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 功能页 -->
                    <StackPanel x:Name="FeaturesPanel" Visibility="Collapsed">
                        <TextBlock Text="系统功能" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBlock Text="禁用不需要的 Windows 可选功能" Foreground="#888" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="全选" Click="SelectAllFeatures_Click" Padding="16,4" Margin="0,0,8,0"/>
                            <Button Content="反选" Click="InvertFeatures_Click" Padding="16,4" Margin="0,0,8,0"/>
                            <Button Content="清空" Click="ClearFeatures_Click" Padding="16,4"/>
                        </StackPanel>
                        <ItemsControl x:Name="FeaturesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,4" FontSize="13"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 注册表 Tweaks 页 -->
                    <StackPanel x:Name="TweaksPanel" Visibility="Collapsed">
                        <TextBlock Text="注册表 Tweaks" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        <ItemsControl x:Name="TweaksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" FontSize="13"/>
                                        <TextBlock Text="{Binding Desc}" FontSize="11" Foreground="#999" Margin="24,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 应用更改页 -->
                    <StackPanel x:Name="ApplyPanel" Visibility="Collapsed">
                        <TextBlock Text="应用更改" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        
                        <!-- 步骤 1 -->
                        <Border Background="#E8F5E9" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="步骤 1：应用更改" FontWeight="Bold" Foreground="#2E7D32"/>
                                <TextBlock Text="移除勾选的预装应用、禁用勾选的系统功能" FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
                                <Button x:Name="ApplyBtn" Content="开始应用更改" Click="Apply_Click" Padding="20,6" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,8,0,0" IsEnabled="False"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- 步骤 2 -->
                        <Border Background="#FFF3E0" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="步骤 2：提交更改" FontWeight="Bold" Foreground="#E65100"/>
                                <TextBlock Text="把所有修改保存到 WIM 镜像文件中" FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
                                <Button x:Name="CommitBtn" Content="提交更改" Click="Commit_Click" Padding="20,6" Background="#FF9800" Foreground="White" FontWeight="Bold" Margin="0,8,0,0" IsEnabled="False"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- 步骤 3 -->
                        <Border Background="#E3F2FD" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="步骤 3：导出镜像" FontWeight="Bold" Foreground="#1565C0"/>
                                <TextBlock Text="导出一个新的、更小的精简版 ISO 文件" FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="ExportWimBtn" Content="导出 WIM" Click="ExportWim_Click" Padding="20,6" Margin="0,0,8,0" IsEnabled="False"/>
                                    <Button x:Name="ExportIsoBtn" Content="导出 ISO" Click="ExportIso_Click" Padding="20,6" Background="#1976D2" Foreground="White" IsEnabled="False"/>
                                </StackPanel>
                                <ProgressBar x:Name="ExportProgressBar" Height="8" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- 步骤 4 -->
                        <Border Background="#F3E5F5" CornerRadius="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="步骤 4：卸载" FontWeight="Bold" Foreground="#7B1FA2"/>
                                <TextBlock Text="清理临时挂载文件" FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
                                <Button x:Name="UnmountBtn" Content="卸载并清理" Click="Unmount_Click" Padding="20,6" Margin="0,8,0,0" IsEnabled="False"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 底部日志 -->
        <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                 Background="#263238" Foreground="#B0BEC5" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>

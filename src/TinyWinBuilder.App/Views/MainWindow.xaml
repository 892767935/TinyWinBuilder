<Window x:Class="TinyWinBuilder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TinyWin Builder - 离线 Windows 精简工具"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Height="50" Background="#1976D2">
            <TextBlock Text="TinyWin Builder" Foreground="White" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <ListBox x:Name="NavList" Grid.Column="0"
                     Background="#FFFFFF" BorderThickness="0,0,1,0" BorderBrush="#E0E0E0">
                <ListBoxItem Content="图像" IsSelected="True" Padding="16,12"/>
                <ListBoxItem Content="预装应用" Padding="16,12"/>
                <ListBoxItem Content="系统功能" Padding="16,12"/>
                <ListBoxItem Content="注册表 Tweaks" Padding="16,12"/>
                <ListBoxItem Content="自动部署" Padding="16,12"/>
                <ListBoxItem Content="应用更改" Padding="16,12"/>
            </ListBox>

            <!-- 右侧内容 -->
            <ScrollViewer Grid.Column="1" Padding="20">
                <TextBlock Text="功能区" FontSize="20"/>
            </ScrollViewer>
        </Grid>

        <!-- 底部日志 -->
        <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                 Background="#263238" Foreground="#B0BEC5" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
